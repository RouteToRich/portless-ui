# ── Which application this is, to auth ──────────────────────────────────────
# PortLess's auth-service app account (a UUID minted by the account-management
# console). Sent as `account_id` on sign-in / sign-up, like MakeMeRich's
# REACT_APP_MAKEMERICH_ACCOUNT_ID. Public (inlined into the bundle), not a
# secret. Until it is set the sign-in page explains that and refuses to submit.
VITE_PORTLESS_ACCOUNT_ID=

# ── The one direct call: the approvals SSE stream ───────────────────────────
# A serverless gateway cannot hold a stream open, so the stream is opened
# against the backend DIRECTLY. Absolute backend URL, inlined into the bundle;
# the backend's FRONTEND_URL must allow this site's origin. Leave empty in dev
# with BACKEND_PROXY_TARGET below (the stream then goes through the dev proxy).
VITE_SSE_BASE_URL=

# ── Dev proxy (read by the dev server only, never inlined) ──────────────────
# /auth/* -> <gateway>/auth/* (auth-service); /api/* -> <gateway>/api/portless/*.
# Default: the deployed RouteToRich gateway.
GATEWAY_PROXY_TARGET=https://api-gateway-two-nu.vercel.app
# Send /api/* straight to a local backend instead of through the gateway. The
# backend checks every token with the gateway itself, so sign-in still works.
BACKEND_PROXY_TARGET=http://localhost:8081

# ── Automation mode (local only) ────────────────────────────────────────────
# The Automation toggle, menu entry and page are shown only on the local dev
# server (npm run dev). A deployed build never shows them; set this to true only
# for a LOCAL production build (npm run build && npm run preview) against a local
# backend. Never set it in the Vercel project.
# VITE_AUTOMATION_ENABLED=

